# -----------------------------------------------------------------------
# Required settings
# -----------------------------------------------------------------------

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Comma-separated list of admin Telegram user IDs
ADMIN_IDS=123456789,987654321

# Main channel ID or @username where all resources are published
# Examples: @my_main_channel  OR  -1001234567890
MAIN_CHANNEL=@my_main_channel

# -----------------------------------------------------------------------
# Province-specific channels (optional)
# Set the channel ID / @username for each province you want to support.
# Leave blank or omit any province you do not need.
# -----------------------------------------------------------------------
